--TEST--
@PREFIX@ benchmark functions produce the reference results
--EXTENSIONS--
@EXT@
--FILE--
<?php
$p = '@PREFIX@';
$call = fn (string $name, ...$args) => ($p . '_' . $name)(...$args);
$obj = new stdClass();

$call('empty');
$call('parse_multi', 42, 'hello', 3.14, true, [1, 2, 3], $obj, 'mixed');
$call('parse_multi', 42, 'hello', 3.14, true, [1, 2, 3], $obj, 'mixed', 99);
$call('parse_multi_pp', 42, 'hello', 3.14, true, [1, 2, 3], $obj, 'mixed', null);
var_dump($call('array_sum_fast', range(1, 1000)));
var_dump($call('array_sum_parse', [1, 'x', 2, 3.5, 4]));
var_dump($call('add', 40, 2), $call('add', PHP_INT_MAX, 1) === PHP_INT_MIN);
var_dump($call('muladd', 1.5, 2.0, 0.25));
var_dump($call('str_len', "a\0b"));
var_dump($call('int_to_string', -1234567890), $call('int_to_string', 7));
var_dump(bin2hex($call('str_upper', "hello, World\xff!")), $call('str_upper', ''));
var_dump($call('array_sum_assoc', ['ab' => 1, 'cde' => 2, 5 => 10, 'f' => 'skip']));
var_dump($call('array_build', 5), $call('array_build', 0));
try { $call('array_build', -1); } catch (ValueError $e) { echo $e->getMessage(), "\n"; }
$map = ['k1' => 'one', 'k2' => [2]];
var_dump($call('hash_lookup', $map, 'k2'), $call('hash_lookup', $map, 'missing'));
$source = [1, 2, 3];
$same = $call('array_identity', $source);
$same[] = 4;
var_dump($source, $same);
try { $call('throw', 7); } catch (Exception $e) { var_dump($e->getMessage(), $e->getCode()); }
var_dump($call('split', 'a,,b,c', ','), $call('split', 'abc', '::'), $call('split', '', ','));
try { $call('split', 'abc', ''); } catch (ValueError $e) { echo $e->getMessage(), "\n"; }

var_dump($call('counter'), $call('counter'));
var_dump($call('invoke', fn ($x) => $x * 2, 21));
try { $call('invoke', function () { throw new LogicException('from callback'); }, 1); } catch (LogicException $e) { echo $e->getMessage(), "\n"; }

$class = '@CLASS@';
$point = new $class(3.0, 4.0);
var_dump($point->length());
$point->translate(1.0, -1.0);
var_dump($point->length());
echo "done\n";
?>
